#!/bin/sh
set -e

APP_PATH="/var/jb/Applications/UltraHidePro.app"

# 1. Ensure file ownership and permissions for mobile/root
if [ -d "$APP_PATH" ]; then
    chown -R mobile:mobile "$APP_PATH" 2>/dev/null || chown -R 501:501 "$APP_PATH" 2>/dev/null || true
    chmod -R 0755 "$APP_PATH" 2>/dev/null || true
    if [ -f "$APP_PATH/Info.plist" ]; then
        chmod 0644 "$APP_PATH/Info.plist" 2>/dev/null || true
    fi
    if [ -f "$APP_PATH/UltraHidePro" ]; then
        chmod 0755 "$APP_PATH/UltraHidePro" 2>/dev/null || true
    fi
fi

# 2. Locate uicache binary
UICACHE=""
for P in /var/jb/usr/bin/uicache /usr/bin/uicache; do
    if [ -x "$P" ]; then
        UICACHE="$P"
        break
    fi
done
if [ -z "$UICACHE" ] && which uicache >/dev/null 2>&1; then
    UICACHE="$(which uicache)"
fi

# 3. Helper to execute commands as mobile user (crucial for user-level LaunchServices database)
run_as_mobile() {
    CMD="$1"
    if which su >/dev/null 2>&1; then
        su -c "$CMD" mobile 2>/dev/null || su mobile -c "$CMD" 2>/dev/null || eval "$CMD" 2>/dev/null || true
    elif [ -x /bin/su ]; then
        /bin/su -c "$CMD" mobile 2>/dev/null || /bin/su mobile -c "$CMD" 2>/dev/null || eval "$CMD" 2>/dev/null || true
    elif [ -x /var/jb/bin/su ]; then
        /var/jb/bin/su -c "$CMD" mobile 2>/dev/null || /var/jb/bin/su mobile -c "$CMD" 2>/dev/null || eval "$CMD" 2>/dev/null || true
    else
        eval "$CMD" 2>/dev/null || true
    fi
}

# 4. Register UltraHidePro.app with LaunchServices
if [ -n "$UICACHE" ] && [ -d "$APP_PATH" ]; then
    # Register app path as mobile user
    run_as_mobile "$UICACHE -p '$APP_PATH'"
    # Register app path as root user
    "$UICACHE" -p "$APP_PATH" 2>/dev/null || true

    # If canonical/realpath differs, register it as well
    REAL_PATH=""
    if which realpath >/dev/null 2>&1; then
        REAL_PATH="$(realpath "$APP_PATH" 2>/dev/null || true)"
    elif which readlink >/dev/null 2>&1; then
        REAL_PATH="$(readlink -f "$APP_PATH" 2>/dev/null || true)"
    fi
    if [ -n "$REAL_PATH" ] && [ "$REAL_PATH" != "$APP_PATH" ] && [ -d "$REAL_PATH" ]; then
        run_as_mobile "$UICACHE -p '$REAL_PATH'"
        "$UICACHE" -p "$REAL_PATH" 2>/dev/null || true
    fi

    # Refresh all application caches for mobile and root
    run_as_mobile "$UICACHE -a"
    "$UICACHE" -a 2>/dev/null || true
fi

# 5. Broadcast Darwin notifications so SpringBoard / LaunchServices detect changes immediately
for NOTIFY in /var/jb/usr/bin/notifyutil /usr/bin/notifyutil; do
    if [ -x "$NOTIFY" ]; then
        "$NOTIFY" -p com.apple.mobile.applicationinstalled 2>/dev/null || true
        "$NOTIFY" -p com.apple.LaunchServices.applicationsChanged 2>/dev/null || true
        break
    fi
done

# Touch LaunchServices cache directory timestamp
touch /var/mobile/Library/Caches 2>/dev/null || true

# 6. Ensure UltraHide Pro config directory and file are writable by all apps and mobile user
mkdir -p /var/jb/Library/UltraHidePro 2>/dev/null || true
chmod 0777 /var/jb/Library/UltraHidePro 2>/dev/null || true
chown -R mobile:mobile /var/jb/Library/UltraHidePro 2>/dev/null || true
if [ -f /var/jb/Library/UltraHidePro/config.plist ]; then
    chmod 0666 /var/jb/Library/UltraHidePro/config.plist 2>/dev/null || true
    chown mobile:mobile /var/jb/Library/UltraHidePro/config.plist 2>/dev/null || true
fi

# 7. Asynchronously trigger SpringBoard reload 2 seconds after dpkg exits cleanly
(
    sleep 2
    if [ -x /var/jb/usr/bin/sbreload ]; then
        /var/jb/usr/bin/sbreload 2>/dev/null || true
    elif [ -x /usr/bin/sbreload ]; then
        /usr/bin/sbreload 2>/dev/null || true
    elif which sbreload >/dev/null 2>&1; then
        sbreload 2>/dev/null || true
    elif [ -n "$UICACHE" ]; then
        run_as_mobile "$UICACHE -a -r"
    fi
) >/dev/null 2>&1 &

exit 0
